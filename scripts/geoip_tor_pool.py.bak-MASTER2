#!/usr/bin/env python3
"""Tor SOCKS pool helper for GeoIP enrich (multi-instance rotation)."""
from __future__ import annotations

import argparse
import json
import os
import socket
import sys
from pathlib import Path

from geoip_http import fetch, tor_socks_endpoints


def probe(proxy: tuple[str, int], timeout: float = 5.0) -> dict:
    host, port = proxy
    out = {"host": host, "port": port, "ok": False, "error": ""}
    try:
        s = socket.create_connection((host, port), timeout=timeout)
        s.sendall(b"\x05\x01\x00")
        resp = s.recv(2)
        s.close()
        out["ok"] = resp == b"\x05\x00"
        if not out["ok"]:
            out["error"] = f"greet {resp!r}"
    except OSError as e:
        out["error"] = str(e)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description="GeoIP Tor SOCKS pool status")
    ap.add_argument("--probe", action="store_true", help="probe each configured endpoint")
    ap.add_argument("--check-url", default="", help="optional fetch test URL via tor")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    endpoints = list(tor_socks_endpoints())
    report = {
        "env": os.environ.get("GEOIP_TOR_SOCKS", ""),
        "endpoints": [{"host": h, "port": p} for h, p in endpoints],
        "alive": [],
        "dead": [],
    }
    if args.probe:
        for ep in endpoints:
            r = probe(ep)
            (report["alive"] if r["ok"] else report["dead"]).append(r)

    if args.check_url:
        try:
            body = fetch(args.check_url, use_tor=True)
            report["check_url"] = {"ok": True, "bytes": len(body)}
        except Exception as e:  # noqa: BLE001
            report["check_url"] = {"ok": False, "error": str(e)}

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"endpoints={len(endpoints)} alive={len(report.get('alive', []))}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
