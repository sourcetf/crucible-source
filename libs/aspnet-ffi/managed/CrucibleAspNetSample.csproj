<Project Sdk="Microsoft.NET.Sdk">
  <!--
    最小 real ASP.NET/hostfxr 样例（libs/aspnet-ffi/aspnet_engine.c 的托管理路）。
    只依赖 Microsoft.NETCore.App（无 NuGet 包、无 Kestrel）：
    C 宿主用 hostfxr_initialize_for_runtime_config +
    hostfxr_get_runtime_delegate(hdt_load_assembly_and_get_function_pointer) 加载本
    程序集并调用 Handler.Render（UnmanagedCallersOnly），全程进程内。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CrucibleAspNetSample</AssemblyName>
    <RootNamespace>Crucible.AspNet.Sample</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
