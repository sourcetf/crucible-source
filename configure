#!/bin/sh
# Crucible configure — generates config.mk and build/crucible-build.toml
# Usage: ./configure [--target=linux|openbsd|auto] [--enable-nss] [--enable-tomcrypt] [--prefix=PATH]
set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
TARGET="${CRUCIBLE_TARGET:-auto}"
ENABLE_NSS=no
ENABLE_TOMCRYPT=no
PREFIX=/usr/local
WORKER_THREADS=2

usage() {
  cat <<'EOF'
Usage: ./configure [options]
  --target=linux|openbsd|auto   Build target OS (default: auto = uname)
  --enable-nss                  Enable NSS legacy TLS module (default: off)
  --enable-tomcrypt             Enable TomCrypt legacy TLS (default: off)
  --prefix=PATH                 Install prefix (default: /usr/local)
  --worker-threads=N            Tokio worker_threads for bench (default: 2)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --target=*) TARGET="${1#*=}" ;;
    --target) TARGET="$2"; shift ;;
    --enable-nss) ENABLE_NSS=yes ;;
    --enable-tomcrypt) ENABLE_TOMCRYPT=yes ;;
    --prefix=*) PREFIX="${1#*=}" ;;
    --prefix) PREFIX="$2"; shift ;;
    --worker-threads=*) WORKER_THREADS="${1#*=}" ;;
    --worker-threads) WORKER_THREADS="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

if [ "$TARGET" = auto ]; then
  case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    linux) TARGET=linux ;;
    openbsd) TARGET=openbsd ;;
    *) echo "configure: unsupported host OS $(uname -s)" >&2; exit 1 ;;
  esac
fi

if [ "$ENABLE_NSS" = no ]; then
  if [ "$TARGET" = openbsd ]; then
    if ls /usr/local/lib/libnss3.so* >/dev/null 2>&1 \
      || ls /usr/local/lib/mozilla*/libnss3.so* >/dev/null 2>&1; then
      ENABLE_NSS=yes
    fi
  fi
fi
if [ "$ENABLE_TOMCRYPT" = no ]; then
  if ls /usr/local/lib/libtomcrypt.so* >/dev/null 2>&1 \
    || ls /usr/local/lib/libtomcrypt.a >/dev/null 2>&1 \
    || [ -f "${ROOT}/target/tls-libs/libtomcrypt.a" ]; then
    ENABLE_TOMCRYPT=yes
  elif [ "$TARGET" = openbsd ]; then
    # No OpenBSD package — vendored static build via scripts/build_libtomcrypt.sh
    ENABLE_TOMCRYPT=yes
  fi
fi

case "$TARGET" in
  linux)
    GO_ENGINE_MODE=ffi
    CARGO_FEATURES="tls,tls_boring,linux_busy_poll,linux_syncookie"
    CC="${CC:-gcc}"
    ;;
  openbsd)
    GO_ENGINE_MODE=shm
    CARGO_FEATURES="tls,tls_boring,go_shm_ipc"
    if [ -x /usr/local/bin/gcc ]; then
      CC=/usr/local/bin/gcc
    else
      CC="${CC:-cc}"
    fi
  ;;
  *)
    echo "configure: invalid --target=$TARGET (linux|openbsd)" >&2
    exit 1
    ;;
esac

if [ "$ENABLE_NSS" = yes ]; then
  CARGO_FEATURES="${CARGO_FEATURES},tls_nss"
fi
if [ "$ENABLE_TOMCRYPT" = yes ]; then
  CARGO_FEATURES="${CARGO_FEATURES},tls_tomcrypt"
fi

mkdir -p "${ROOT}/build"

cat > "${ROOT}/config.mk" <<EOF
# Generated by configure — do not edit
ROOT := ${ROOT}
TARGET_OS := ${TARGET}
GO_ENGINE_MODE := ${GO_ENGINE_MODE}
CARGO_FEATURES := ${CARGO_FEATURES}
CC := ${CC}
PREFIX := ${PREFIX}
WORKER_THREADS := ${WORKER_THREADS}
export PATH := /usr/local/bin:/usr/local/sbin:\$(HOME)/.cargo/bin:\$(PATH)
EOF

cat > "${ROOT}/build/crucible-build.toml" <<EOF
# Generated by configure — read by build.rs
target_os = "${TARGET}"
go_engine_mode = "${GO_ENGINE_MODE}"
worker_threads = ${WORKER_THREADS}
enable_nss = ${ENABLE_NSS}
enable_tomcrypt = ${ENABLE_TOMCRYPT}
EOF

echo "configure: TARGET_OS=${TARGET} GO_ENGINE_MODE=${GO_ENGINE_MODE}"
echo "configure: CARGO_FEATURES=${CARGO_FEATURES}"
echo "configure: wrote config.mk and build/crucible-build.toml"


# Refuse cross-lying: --target=linux on OpenBSD (or reverse) silently mis-builds engines.
HOST_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$HOST_OS" in
  linux*) HOST_OS=linux ;;
  openbsd*) HOST_OS=openbsd ;;
esac
if [ -n "${TARGET_OS:-}" ] && [ "$TARGET_OS" != "auto" ] && [ "$TARGET_OS" != "$HOST_OS" ]; then
  echo "configure: ERROR HOST_OS_MISMATCH host=$HOST_OS --target=$TARGET_OS" >&2
  echo "configure: refusing to enable foreign OS features / go engine mode" >&2
  exit 1
fi
