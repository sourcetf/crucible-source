# Build artifacts
target/
**/target/
*.pdb
*.rlib
*.o
*.so
*.dylib
*.dll
*.exe
*.bin

# Lock files (rebuild fresh)
# Keep Cargo.lock actually — it's needed for reproducible builds
# Cargo.lock

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Runtime state (zones, keys, log)
state/
*.journal
*.signed
*.jbk
*.jnl

# Secrets
*.key
*.pem
*.crt
config/secrets.*
.env
.env.*

# Local notes
*.local
# 例外：部署钩子按 OpenBSD 惯例就叫 rc.local / daily.local，必须入库（见 scripts/deploy/）
!scripts/deploy/*.local
*.log
*.tmp
*.bak

# Agent/IDE scratch
.cursor/
.agents/
.codegraph/

# Test debris
*.b64
*.pkt
*.wire
pg.*
nul
out/
scratch/
tmp_*/
.cache/

# Scripts that were one-off deployment helpers
_remote*.txt
_sync*.txt
_probe*.py
_build_errors*
_remote.py
_remote_*.py
data/
__pycache__/
*.pyc
*.core
webserver.core

# Compiled helpers / dev clutter
www-apps/go/deps/bin/
scripts/*/mmdb2jsonl
*.bak
*.bak-*
contact.txt
*.sh

# 部署用二进制目录（/crucible/bin/webserver 是生产运行的那一份；target/ 里的是 cargo 产物，
# 重建时会被替换，硬链接计数为 2，不能直接当生产入口）
/bin/

# 应用引擎运行期生成的依赖标记目录（只有 manifest/.ready 这类标记，没有源码）
www-apps/*/deps/

# 运维/验证脚本：*.sh 整体忽略，但这个要入库（ECH 内外层端到端演示）
!scripts/ech_demo.sh
