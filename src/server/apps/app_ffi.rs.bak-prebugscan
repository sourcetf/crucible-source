//! dlopen-based app engine FFI (RTLD_GLOBAL). c/go/rust inline on caller thread when possible.

use crate::config::{AppRouteConfig, ListenerConfig};
use crate::server::apps::env_lock;
use crate::server::h1::{full, BoxBody};
use anyhow::{bail, Context, Result};
use bytes::Bytes;
use http::{Request, Response, StatusCode};
use hyper::body::Incoming;
use once_cell::sync::Lazy;
use parking_lot::Mutex;
use std::collections::HashMap;
use std::ffi::{CStr, CString};
use std::net::SocketAddr;
use std::os::raw::{c_char, c_int, c_void};
use std::path::PathBuf;
use std::sync::Arc;

#[repr(C)]
struct AppEngineResult {
    status: c_int,
    headers: *mut c_char,
    headers_len: usize,
    body: *mut u8,
    body_len: usize,
    error: *mut c_char,
}

type InitFn = unsafe extern "C" fn(*const c_char, *const c_char) -> c_int;
type ExecFn = unsafe extern "C" fn(
    *const c_char,
    *const c_char,
    *const c_char,
    *const c_char,
    *const c_char,
    *const c_char,
    *const u8,
    usize,
    *const c_char,
    *const c_char,
    c_int,
    *const c_char,
    *mut AppEngineResult,
) -> c_int;
type FreeFn = unsafe extern "C" fn(*mut AppEngineResult);
type ShutdownFn = unsafe extern "C" fn();

struct EngineLib {
    handle: *mut c_void,
    #[allow(dead_code)]
    init: InitFn,
    exec: ExecFn,
    free: FreeFn,
    shutdown: ShutdownFn,
}

unsafe impl Send for EngineLib {}
unsafe impl Sync for EngineLib {}

static LIBS: Lazy<Mutex<HashMap<String, Arc<EngineLib>>>> =
    Lazy::new(|| Mutex::new(HashMap::new()));

pub async fn execute(
    req: &Request<Incoming>,
    lc: &ListenerConfig,
    app: &AppRouteConfig,
    peer: SocketAddr,
) -> Result<Response<BoxBody>> {
    let path = req.uri().path().to_string();
    let method = req.method().as_str().to_string();
    let query = req.uri().query().unwrap_or("").to_string();
    let engine = app.engine.to_ascii_lowercase();
    let lib_path = resolve_lib(app, &engine)?;
    let docroot = app
        .docroot
        .clone()
        .unwrap_or_else(|| lc.root.clone());
    let script = docroot.join(path.trim_start_matches('/'));
    let port = lc.port;
    let inline = matches!(engine.as_str(), "c" | "go" | "rust");

    let result = if inline {
        run_inline(&engine, &lib_path, &script, &docroot, &method, &path, &query, peer, port)?
    } else {
        tokio::task::spawn_blocking(move || {
            env_lock::with_temp_env_named(&engine, &[], || {
                let lib = load_engine(&engine, &lib_path)?;
                call_exec(
                    &lib, &engine, &script, &docroot, &method, &path, &query, peer, port,
                )
            })
        })
        .await??
    };

    Ok(Response::builder()
        .status(StatusCode::from_u16(result.0 as u16).unwrap_or(StatusCode::OK))
        .header(http::header::CONTENT_TYPE, "text/plain; charset=utf-8")
        .body(full(result.1))
        .unwrap())
}

pub async fn execute_simple(
    req: &Request<()>,
    lc: &ListenerConfig,
    app: &AppRouteConfig,
    peer: SocketAddr,
) -> Result<Bytes> {
    let path = req.uri().path().to_string();
    let method = req.method().as_str().to_string();
    let query = req.uri().query().unwrap_or("").to_string();
    let engine = app.engine.to_ascii_lowercase();
    let lib_path = resolve_lib(app, &engine)?;
    let docroot = app
        .docroot
        .clone()
        .unwrap_or_else(|| lc.root.clone());
    let script = docroot.join(path.trim_start_matches('/'));
    let port = lc.port;
    let inline = matches!(engine.as_str(), "c" | "go" | "rust");
    let (_status, body) = if inline {
        run_inline(&engine, &lib_path, &script, &docroot, &method, &path, &query, peer, port)?
    } else {
        tokio::task::spawn_blocking(move || {
            env_lock::with_temp_env_named(&engine, &[], || {
                let lib = load_engine(&engine, &lib_path)?;
                call_exec(
                    &lib, &engine, &script, &docroot, &method, &path, &query, peer, port,
                )
            })
        })
        .await??
    };
    Ok(body)
}

fn run_inline(
    engine: &str,
    lib_path: &PathBuf,
    script: &PathBuf,
    docroot: &PathBuf,
    method: &str,
    path: &str,
    query: &str,
    peer: SocketAddr,
    port: u16,
) -> Result<(i32, Bytes)> {
    let lib = load_engine(engine, lib_path)?;
    call_exec(
        &lib, engine, script, docroot, method, path, query, peer, port,
    )
}

fn resolve_lib(app: &AppRouteConfig, engine: &str) -> Result<PathBuf> {
    if let Some(p) = &app.lib {
        return Ok(p.clone());
    }
    let env_key = format!("APPENGINE_{}_LIB", engine.to_ascii_uppercase());
    if let Ok(p) = std::env::var(&env_key) {
        return Ok(PathBuf::from(p));
    }
    Ok(PathBuf::from(format!(
        "target/app-engines/libapp_{engine}.so"
    )))
}

fn load_engine(engine: &str, lib_path: &PathBuf) -> Result<Arc<EngineLib>> {
    {
        let map = LIBS.lock();
        if let Some(l) = map.get(engine) {
            return Ok(Arc::clone(l));
        }
    }
    if !lib_path.is_file() {
        bail!("missing engine lib {}", lib_path.display());
    }
    let c_path = CString::new(lib_path.to_string_lossy().as_bytes()).context("lib path")?;
    unsafe {
        let flags = libc::RTLD_NOW | libc::RTLD_GLOBAL;
        let handle = libc::dlopen(c_path.as_ptr(), flags);
        if handle.is_null() {
            let err = CStr::from_ptr(libc::dlerror());
            bail!("dlopen {}: {}", lib_path.display(), err.to_string_lossy());
        }
        macro_rules! sym {
            ($name:expr) => {{
                let n = CString::new($name).unwrap();
                let p = libc::dlsym(handle, n.as_ptr());
                if p.is_null() {
                    libc::dlclose(handle);
                    bail!("missing symbol {}", $name);
                }
                p
            }};
        }
        let init: InitFn = std::mem::transmute(sym!("appengine_init"));
        let exec: ExecFn = std::mem::transmute(sym!("appengine_execute"));
        let free: FreeFn = std::mem::transmute(sym!("appengine_result_free"));
        let shutdown: ShutdownFn = std::mem::transmute(sym!("appengine_shutdown"));
        let eng = CString::new(engine).unwrap();
        let hint = CString::new(lib_path.to_string_lossy().as_bytes()).unwrap();
        let rc = init(eng.as_ptr(), hint.as_ptr());
        if rc != 0 {
            libc::dlclose(handle);
            bail!("appengine_init failed: {rc}");
        }
        let lib = Arc::new(EngineLib {
            handle,
            init,
            exec,
            free,
            shutdown,
        });
        LIBS.lock().insert(engine.to_string(), Arc::clone(&lib));
        Ok(lib)
    }
}

fn call_exec(
    lib: &EngineLib,
    engine: &str,
    script: &PathBuf,
    docroot: &PathBuf,
    method: &str,
    path: &str,
    query: &str,
    peer: SocketAddr,
    port: u16,
) -> Result<(i32, Bytes)> {
    let c_script = CString::new(script.to_string_lossy().as_bytes())?;
    let c_doc = CString::new(docroot.to_string_lossy().as_bytes())?;
    let c_method = CString::new(method)?;
    let c_path = CString::new(path)?;
    let c_query = CString::new(query)?;
    let c_ct = CString::new("")?;
    let c_remote = CString::new(peer.ip().to_string())?;
    let c_server = CString::new("crucible")?;
    let c_extra = CString::new(engine)?;
    let mut out = AppEngineResult {
        status: 500,
        headers: std::ptr::null_mut(),
        headers_len: 0,
        body: std::ptr::null_mut(),
        body_len: 0,
        error: std::ptr::null_mut(),
    };
    let _ = engine;
    unsafe {
        let rc = (lib.exec)(
            c_script.as_ptr(),
            c_doc.as_ptr(),
            c_method.as_ptr(),
            c_path.as_ptr(),
            c_query.as_ptr(),
            c_ct.as_ptr(),
            std::ptr::null(),
            0,
            c_remote.as_ptr(),
            c_server.as_ptr(),
            port as c_int,
            c_extra.as_ptr(),
            &mut out,
        );
        if rc != 0 {
            let msg = if !out.error.is_null() {
                CStr::from_ptr(out.error).to_string_lossy().into_owned()
            } else {
                format!("exec rc={rc}")
            };
            (lib.free)(&mut out);
            bail!("{msg}");
        }
        let body = if out.body.is_null() || out.body_len == 0 {
            Bytes::new()
        } else {
            Bytes::copy_from_slice(std::slice::from_raw_parts(out.body, out.body_len))
        };
        let status = out.status;
        (lib.free)(&mut out);
        Ok((status, body))
    }
}

#[allow(dead_code)]
pub fn shutdown_engine(engine: &str) {
    let mut map = LIBS.lock();
    if let Some(lib) = map.remove(engine) {
        unsafe {
            (lib.shutdown)();
            libc::dlclose(lib.handle);
        }
    }
}
