index = "index.aspx"

# Fair plain :19081
[[listeners]]
address = "127.0.0.1"
port = 19081
root = "www-static-fair"
autoindex = true
http_versions = ["h1", "h2"]
server_name = "fair-plain-test.crucible.local"
status_path = "/__status"

# Fair TLS1.2 :19445
[[listeners]]
address = "127.0.0.1"
port = 19445
root = "www-static-fair-tls12"
autoindex = true
http_versions = ["h1", "h2"]
server_name = "fair-tls12-test.crucible.local"
ssl = { cert = "cert.pem", key = "key.pem", prefer_tls13 = false, versions = ["TLSv1.2"], enable_nss = true, enable_tomcrypt = true }

# Fair TLS1.3 :19446
[[listeners]]
address = "127.0.0.1"
port = 19446
root = "www-static-fair-tls13"
autoindex = true
http_versions = ["h1", "h2"]
server_name = "fair-tls13-test.crucible.local"
ssl = { cert = "cert.pem", key = "key.pem", prefer_tls13 = true, versions = ["TLSv1.2", "TLSv1.3"] }

# Prod-like TLS :18443 (H3 enabled)
[[listeners]]
address = "127.0.0.1"
port = 18443
root = "www"
autoindex = { enabled = true, paths = ["/"] }
http_versions = ["h1", "h2", "h3"]
server_name = "prod-test.crucible.local"
ssl = { cert = "cert.pem", key = "key.pem", cert_ec = "cert_ec.pem", key_ec = "key_ec.pem", prefer_tls13 = true, pqc = true, ech = true, ech_keys = "state/ech/ech_keys.pem", enable_nss = true, enable_tomcrypt = true }

# 公网 HTTPS :443 —— DoH（/dns-query）+ ECH 对外服务口
[[listeners]]
address = "0.0.0.0"
port = 8443
root = "www-doh"
autoindex = { enabled = true, paths = ["/"] }
http_versions = ["h1", "h2", "h3"]
server_name = "crucible.local"
ssl = { cert = "cert.pem", key = "key.pem", cert_ec = "cert_ec.pem", key_ec = "key_ec.pem", prefer_tls13 = true, pqc = true, ech = true, ech_keys = "state/ech/ech_keys.pem" }

# ---------- DNS (bind9 named) —— 公网生产模式 ----------
# 53（权威+公共递归+根）、rndc 953、DoT 0.0.0.0:853、DoH 走 :443 /dns-query + ECH
[dns]
enabled = true
test_mode = false
modes = { root = true, recursive = true, authoritative = true }
listen_addr = "any"
recursion_acl = ["0.0.0.0/0"]
axfr_out_acl = ["127.0.0.0/8"]

[dns.dnssec]
enabled = true
algorithm = "ECDSAP256SHA256"
rotation_enabled = true
rotation_days = 30
ksk_lifetime_days = 365
nsec3 = true
nsec3_iterations = 0

[dns.dot]
enabled = true
port = 853
cert = "cert.pem"
key = "key.pem"

[dns.doh]
enabled = true
path = "/dns-query"
hostnames = []

[dns.geo]
enabled = true

[[dns.geo.lines]]
name = "lab-a"
cidrs = ["192.0.2.0/24"]

[[dns.geo.lines]]
name = "lab-b"
cidrs = ["198.51.100.0/24"]

[[dns.rpz]]
name = "blocked.crucible.test"
rtype = "nxdomain"
value = ""

[[dns.rpz]]
name = "www.crucible.test"
rtype = "A"
value = "192.0.2.88"

[dns.rootzone]
enabled = false

# L4 forwarding test (root 字段虽然不需要但 serde 必填，给占位目录)
[[listeners]]
address = "127.0.0.1"
port = 55555
root = "www-static-fair"
l4_forward = "127.0.0.1:55556"

[[listeners]]
address = "127.0.0.1"
port = 55556
root = "www-static-fair"
autoindex = { enabled = true, paths = ["/"] }
http_versions = ["h1"]
