[[listeners.apps]]
paths = ["/asp"]
enabled = true
engine = "asp"
extensions = ["asp", ""]
lib = "target/app-engines/libapp_asp.so"
docroot = "www-apps/asp"
index = "index.asp"

[[listeners.apps]]
paths = ["/python"]
enabled = true
engine = "python"
extensions = ["py", ""]
lib = "target/app-engines/libapp_python.so"
